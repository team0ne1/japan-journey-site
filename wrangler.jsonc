{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kansai-private-journey",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": ".build/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIP_AUTH",
        "class_name": "TripAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TripAuth"
      ]
    }
  ],
  "vars": {
    "TRIP_ID": "kansai-october-2026"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "0a24af260b9e3362f9bbe75965b2fe44",
  "routes": [
    {
      "pattern": "trip.team0ne.work",
      "custom_domain": true
    }
  ]
}
